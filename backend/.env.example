# Copy to .env and fill in. Never commit .env
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/smart_internship_matcher
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smart_internship_matcher?retryWrites=true&w=majority
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
RECOMMENDATION_ENGINE=rule-based
# Optional: a separate DB for API tests (otherwise mongodb-memory-server is used)
# MONGODB_URI_TEST=mongodb://127.0.0.1:27017/smart_internship_matcher_test
